 "FlightFare" [shape=box, peripheries=2, style=filled, fillcolor="white", margin="0.06,0.04", pos="9.8,3.3!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dfe8fb"><B>FlightFare</B></TD></TR><TR><TD ALIGN="LEFT">seats_allocated</TD></TR><TR><TD ALIGN="LEFT">overbook_pct</TD></TR><TR><TD ALIGN="LEFT">price</TD></TR><TR><TD ALIGN="LEFT"><I>(id: Flight + FareClass)</I></TD></TR></TABLE>>];
