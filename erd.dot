 "Aircraft" [shape=box, peripheries=1, style=filled, fillcolor="white", margin="0.06,0.04", pos="4.9,6.6!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dfe8fb"><B>Aircraft</B></TD></TR><TR><TD ALIGN="LEFT"><U>tail_number</U></TD></TR></TABLE>>];
