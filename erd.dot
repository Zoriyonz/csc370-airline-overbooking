 "Booking" [shape=box, peripheries=1, style=filled, fillcolor="white", margin="0.06,0.04", pos="14.700000000000001,3.3!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#dfe8fb"><B>Booking</B></TD></TR><TR><TD ALIGN="LEFT"><U>booking_id</U></TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">booked_at</TD></TR></TABLE>>];
