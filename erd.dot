 "BumpEvent" -> "Booking" [arrowhead=normal, penwidth=3, color="black", label=<<B>  ISA</B>>, headlabel=<<B>(0,1)</B>>, taillabel=<<B>(1,1)</B>>, labeldistance=3.2, labelangle=-35];
 legend [shape=plaintext, fontsize=12, label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><B>Airline seat reservation with overbooking: ERD</B></TD></TR><TR><TD ALIGN="LEFT">Underlined = identifier. Double box = weak entity set. Double diamond = identifying relationship.</TD></TR><TR><TD ALIGN="LEFT">(min,max) = how many times one instance takes part. Arrowhead = the other side relates to at most one. Black arrow = ISA (subclass).</TD></TR><TR><TD ALIGN="LEFT">Dashed = enforced by the seat triggers, not by a foreign key (a seat belongs to an aircraft type, a booking to a flight).</TD></TR></TABLE>>, pos="9.8,-1.815!"];
}